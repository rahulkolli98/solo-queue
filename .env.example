# Copy to .env.local and fill in. Never commit .env.local.
# Convex (written by `npx convex dev`; local deployment by default)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Base URL of this app (OAuth callbacks + cron health)
APP_BASE_URL=http://localhost:3000
# Threads API — use the Threads App ID + secret from Use Cases > Threads > Customize Settings (NOT the general app credentials)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
# Instagram Platform API — Instagram Login path (no Facebook Page needed)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=
# LLM provider for draft generation (OQ-001: OpenRouter with one pinned model; see README, Decisions closed).
# Local dev and production use the same model, so what you test is what posts.
# Create a key at https://openrouter.ai/keys — any model ID on OpenRouter works.
# Chosen model (founder, 2026-10-06): meta/muse-spark-1.3-contributor, about $0.10 in / $0.20 out per million tokens
# on OpenRouter (price as listed that day; check openrouter.ai). Planned fallback: deepseek/deepseek-v4.1-flash (about $0.30 / $1.20).
LLM_API_KEY=
LLM_MODEL=meta/muse-spark-1.3-contributor
# Optional override; defaults to OpenRouter's OpenAI-compatible endpoint.
# NOTE: base URL only — the provider appends /chat/completions itself.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Dashboard gate (REQUIRED in production — Vercel Hobby cannot protect
# production domains, so this proxy enforces HTTP Basic Auth instead)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# OAuth state-cookie signing secret (REQUIRED — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
OAUTH_STATE_SECRET=
# --- Convex-side variables (NOT read from .env.local) ---
# These live in the Convex deployment environment. Set them with:
#   npx convex env set NAME value            (local backend)
#   npx convex env set --prod NAME value     (production)
# LLM_API_KEY, LLM_MODEL, LLM_BASE_URL, THREADS_*, IG_* and APP_BASE_URL are also
# read by Convex functions, so they must be set there too.
# Publisher mode. The publisher posts for real ONLY when this is exactly 0;
# unset or any other value means dry-run (nothing is claimed or published).
PUBLISH_DRY_RUN=1
# Operator auth (TASK-089). Run: node scripts/operator-keys.mjs --local  (dev) or --print (prod).
#   OPERATOR_JWT_PRIVATE_KEY  -> .env.local / Vercel Production ONLY (signs the browser token)
#   OPERATOR_JWKS             -> Convex env (verifies it): npx convex env set [--prod] OPERATOR_JWKS "<value>"
OPERATOR_JWT_PRIVATE_KEY=
OPERATOR_JWKS=
# Allows the Connections test publish/delete buttons (they post to the real
# Threads account). Off unless exactly 1. Leave unset on production.
ALLOW_TEST_PUBLISH=

# --- Vercel build only (TASK-087; set in Vercel, never in .env.local) ---
# Production deploy key from the Convex dashboard (prod deployment > Settings).
# Used by `npx convex deploy --cmd 'npm run build'` in the Vercel build command.
# Scope it to the Production environment only, never Preview.
CONVEX_DEPLOY_KEY=
